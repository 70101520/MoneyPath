generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(cuid())
  ownerKey String @unique @default("owner")
  email String @unique
  password String
  name String
  salaryDay Int?
  monthlyIncome Int?
  essentialReserve Int?
  emergencyReserve Int?
  goalReserve Int?
  extraDebtReserve Int?
  createdAt DateTime @default(now())
  sessions Session[]
  accounts Account[]
  incomes Income[]
  commitments Commitment[]
  cards Card[]
  expenses Expense[]
  payments Payment[]
  audits Audit[]
  risks RiskSnapshot[]
  budgets Budget[]
  salaryPlans SalaryPlan[]
  debtPlan DebtPlan?
  personalEntries PersonalEntry[]
  settlements PersonalSettlement[]
  advances PersonalAdvance[]
  investments Investment[]
  investmentEvents InvestmentEvent[]
  goals Goal[]
  apiTokens ApiToken[]
  pushSubscriptions PushSubscription[]
  notificationDeliveries NotificationDelivery[]
  chatMessages ChatMessage[]
  cashAdvances CashAdvance[]
  aiSettings AiSettings?
  assistantMemories AssistantMemory[]
}
model AiSettings {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String @default("OLLAMA")
  ollamaUrl String @default("http://ollama:11434")
  ollamaModel String @default("qwen3.5:4b-q4_K_M")
  gptOssUrl String @default("http://gpt-oss:8000/v1")
  gptOssModel String @default("openai/gpt-oss-20b")
  openaiModel String @default("gpt-5.5")
  openaiApiKey String?
  updatedAt DateTime @updatedAt
}
model AssistantMemory {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  content String
  searchText String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
}
model ChatMessage {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role String
  content String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model CashAdvance {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  cardId String
  card Card @relation(fields: [cardId], references: [id])
  accountId String
  account Account @relation(fields: [accountId], references: [id])
  amount Int
  date DateTime @db.Date
  notes String?
  @@index([userId, date])
}
model PushSubscription {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  @@index([userId, createdAt])
}
model NotificationDelivery {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationKey String
  channel String
  status String
  attemptedAt DateTime @default(now())
  error String?
  @@unique([userId, notificationKey, channel])
  @@index([userId, attemptedAt])
}
model ApiToken {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  label String
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastUsedAt DateTime?
  revokedAt DateTime?
  @@index([userId, createdAt])
}
model PersonalEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction String
  reference String
  amount Int
  openingSettled Int @default(0)
  settled Int @default(0)
  openingDate DateTime @db.Date
  dueDate DateTime? @db.Date
  priority String @default("NORMAL")
  paymentReserve Int?
  notes String?
  settlements PersonalSettlement[]
  advances PersonalAdvance[]
  @@index([userId, direction])
}
model PersonalAdvance {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  entryId String
  entry PersonalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account Account @relation(fields: [accountId], references: [id])
  amount Int
  date DateTime @db.Date
  notes String?
  @@index([userId, date])
}
model Investment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  kind String
  contributed Int
  currentValue Int
  monthlyContribution Int
  nextContribution DateTime? @db.Date
  maturityDate DateTime? @db.Date
  liquid Boolean @default(false)
  notes String?
  events InvestmentEvent[]
  @@index([userId, name])
}
model InvestmentEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  investmentId String
  investment Investment @relation(fields: [investmentId], references: [id])
  accountId String?
  account Account? @relation(fields: [accountId], references: [id])
  kind String
  amount Int
  date DateTime @db.Date
  notes String?
  @@index([userId, date])
}
model Goal {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  kind String
  targetDate DateTime @db.Date
  familyContribution Int @default(0)
  personalCash Int @default(0)
  engagement Int @default(0)
  travel Int @default(0)
  shopping Int @default(0)
  emergencyBuffer Int @default(0)
  otherAmount Int @default(0)
  alreadySaved Int @default(0)
  confirmedMoney Int @default(0)
  expectedMoney Int @default(0)
  notes String?
  @@index([userId, targetDate])
}
model PersonalSettlement {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  entryId String
  entry PersonalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account Account @relation(fields: [accountId], references: [id])
  amount Int
  date DateTime @db.Date
  notes String?
  @@index([userId, date])
}
model SalaryPlan {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeId String @unique
  income Income @relation(fields: [incomeId], references: [id])
  essentialReserve Int
  emergencyReserve Int
  goalReserve Int
  extraDebtReserve Int
  cashAtAcceptance Float
  mandatoryAtAcceptance Float
  acceptedAt DateTime @default(now())
  @@index([userId, acceptedAt])
}
model DebtPlan {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyPayment Int
  strategy String
  assumptions Json
  updatedAt DateTime @updatedAt
}
model Budget {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  month String
  category String
  amount Int
  updatedAt DateTime @updatedAt
  @@unique([userId, month, category])
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model LoginAttempt {
  id String @id
  count Int @default(0)
  resetAt DateTime
}
model Account {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  name String
  kind String
  balance Int
  spendable Boolean @default(true)
  incomes Income[]
  expenses Expense[]
  payments Payment[]
  settlements PersonalSettlement[]
  advances PersonalAdvance[]
  investmentEvents InvestmentEvent[]
  cashAdvances CashAdvance[]
}
model Income {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  accountId String?
  account Account? @relation(fields: [accountId], references: [id])
  amount Int
  date DateTime @db.Date
  source String
  recurring Boolean @default(false)
  status String
  balanceApplied Boolean @default(true)
  notes String?
  salaryPlan SalaryPlan?
}
model Commitment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  name String
  category String
  amount Int
  intervalMonths Int
  dueDate DateTime @db.Date
  anchorDay Int
  funded Int @default(0)
  paid Int @default(0)
  essential Boolean @default(true)
  lateFee Int?
  active Boolean @default(true)
  payments Payment[]
}
model Card {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  bank String
  name String
  lastFour String?
  creditLimit Int
  availableLimit Int?
  outstanding Int
  statementAmount Int
  statementPaid Int @default(0)
  carriedBalance Int @default(0)
  carriedDueDate DateTime? @db.Date
  statementDate DateTime @db.Date
  dueDate DateTime @db.Date
  minimumDue Int
  interestBps Int
  lateFee Int?
  status String @default("ACTIVE")
  detailsComplete Boolean @default(true)
  notes String?
  expenses Expense[]
  payments Payment[]
  emis Emi[]
  statements CardStatement[]
  cashAdvances CashAdvance[]
}
model CardStatement {
  id String @id @default(cuid())
  cardId String
  card Card @relation(fields: [cardId], references: [id])
  amount Int
  paid Int
  statementDate DateTime @db.Date
  dueDate DateTime @db.Date
  archivedAt DateTime @default(now())
}
model Emi {
  id String @id @default(cuid())
  cardId String
  card Card @relation(fields: [cardId], references: [id])
  name String
  originalAmount Int
  principalRemaining Int
  monthlyEmi Int
  nextPrincipal Int
  nextInterest Int
  totalInstallments Int
  installmentsPaid Int
  nextDate DateTime @db.Date
  anchorDay Int
}
model Expense {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  accountId String?
  account Account? @relation(fields: [accountId], references: [id])
  cardId String?
  card Card? @relation(fields: [cardId], references: [id])
  amount Int
  date DateTime @db.Date
  category String
  method String
  description String?
  essentiality String
}
model Payment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  accountId String
  account Account @relation(fields: [accountId], references: [id])
  cardId String?
  card Card? @relation(fields: [cardId], references: [id])
  commitmentId String?
  commitment Commitment? @relation(fields: [commitmentId], references: [id])
  destinationAccountId String?
  amount Int
  date DateTime @db.Date
  type String
  notes String?
}
model Audit {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  requestId String @unique
  requestHash String?
  action String
  entityId String
  source String @default("PORTAL")
  conversationMessageId String?
  interpretation String?
  confirmedByUser Boolean @default(false)
  undoneAt DateTime?
  createdAt DateTime @default(now())
}
model RiskSnapshot {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  score Int?
  version String @default("basic-v1")
  rules Json
  metrics Json?
  createdAt DateTime @default(now())
}
