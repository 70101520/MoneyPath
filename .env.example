DATABASE_URL=postgresql://moneypath:change-this-db-password@localhost:5432/moneypath
POSTGRES_PASSWORD=change-this-db-password
APP_ORIGIN=http://localhost:3000
# For a testing VM, use its private IP and matching APP_ORIGIN.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
DB_PORT=5432
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SETUP_TOKEN=
# Set true only for local HTTP; production HTTPS must use false.
ALLOW_INSECURE_COOKIE=true
# Self-hosted by default: no external AI API key is needed.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Optional separate local GPT-OSS service. Start with: docker compose --profile gpt-oss up -d gpt-oss
GPT_OSS_BASE_URL=http://gpt-oss:8000/v1
GPT_OSS_MODEL=openai/gpt-oss-20b
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
# Optional hosted provider. Set AI_PROVIDER=openai and keep the key server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Required to run the Compose notification worker. Generate independently.
JOB_SECRET=
NOTIFICATION_INTERVAL_MS=21600000
# Optional SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional standards-based browser push. Generate a VAPID key pair.
VAPID_SUBJECT=mailto:owner@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
