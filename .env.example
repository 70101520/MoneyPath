DATABASE_URL=postgresql://moneypath:change-this-db-password@localhost:5432/moneypath
POSTGRES_PASSWORD=change-this-db-password
APP_ORIGIN=http://localhost:3000
# For a testing VM, use its private IP and matching APP_ORIGIN.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
SETUP_TOKEN=
# Set true only for local HTTP; production HTTPS must use false.
ALLOW_INSECURE_COOKIE=true
